# TMDB (required — existing)
TMDB_API_READ_ACCESS_TOKEN=
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Database (required for accounts, favorites, watchlist, history to persist)
# MongoDB Atlas has a free tier: https://www.mongodb.com/cloud/atlas/register
# Local MongoDB also works: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=cinematch

# Auth (required — sign a long random string)
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
