# Copy to .env.local and fill in. Never commit real values.

# TMDB API Read Access Token (v4 auth) — https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# MongoDB connection string and database name
MONGODB_URI=
MONGODB_DB=cinematch

# At least 32 random characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Optional: default watch-provider country (ISO 3166-1 alpha-2). Defaults to IN.
# WATCH_REGION=IN
